# App and paper-risk limits
APP_MODE=paper
STARTING_CAPITAL=10000
MAX_RISK_PER_TRADE=50
MAX_TRADES_PER_DAY=2
MAX_OPEN_POSITIONS=1
PAPER_DEFAULT_DAILY_LOSS_LIMIT=300
PAPER_MAX_HOLD_MINUTES=60
PAPER_ENTRY_CUTOFF_HOUR=15
PAPER_ENTRY_CUTOFF_MINUTE=0
PAPER_FORCE_EXIT_HOUR=15
PAPER_FORCE_EXIT_MINUTE=25

# AI provider selection: openai | anthropic | gemini | nvidia | openai_compatible
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
# Required for openai_compatible. NVIDIA defaults to https://integrate.api.nvidia.com/v1
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
AI_WEB_SEARCH_ENABLED=true

# Independent search for research. Options: native | searxng | none
# Use searxng to provide web evidence to NVIDIA and OpenAI-compatible models.
RESEARCH_SEARCH_PROVIDER=native
SEARXNG_BASE_URL=http://127.0.0.1:8888
SEARXNG_TIMEOUT_SECONDS=15

# Legacy OpenAI aliases. Used only when AI_PROVIDER=openai and AI_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Provider-specific optional aliases (AI_API_KEY / AI_MODEL take precedence)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
# See backend/nvidia.env.example for a ready-to-copy NVIDIA NIM profile.

# Upstox app credentials and redirect URI. Use the Upstox Developer Console.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/broker/upstox/callback
# Market data feed token; refresh according to Upstox token lifetime.
UPSTOX_ACCESS_TOKEN=
# Comma-separated Upstox subscriptions. Nifty index defaults are display-only;
# autonomous stock paper trading needs NSE_EQ|... equity instrument keys here.
UPSTOX_INSTRUMENT_KEYS=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank
# Sandbox order token is separate; keep UPSTOX_MODE=sandbox while developing.
UPSTOX_MODE=sandbox
UPSTOX_SANDBOX_TOKEN=

# Optional global-market paper feed from Twelve Data. All symbols are opt-in.
# Example symbols: US equities AAPL,MSFT; FX EUR/USD,GBP/USD; spot commodity XAU/USD.
# Commodity realtime access depends on your Twelve Data plan and entitlement.
TWELVE_DATA_API_KEY=
TWELVE_DATA_US_EQUITIES=
TWELVE_DATA_FOREX=
TWELVE_DATA_COMMODITIES=
# Separate virtual USD account/risk limits; these do not convert or mix with INR P&L.
PAPER_GLOBAL_STARTING_CAPITAL_USD=10000
PAPER_GLOBAL_MAX_RISK_USD=10
PAPER_GLOBAL_DAILY_LOSS_LIMIT_USD=100
PAPER_GLOBAL_MAX_TRADES_PER_DAY=3
PAPER_GLOBAL_MAX_HOLD_MINUTES=240

# HARD SAFETY GATE. Live order submission remains unimplemented.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK=

# Emergency reset, pending-suggestion expiry, and local Excel mirror
KILL_SWITCH_RESET_ALLOWED=true
CANDIDATE_PENDING_TTL_MINUTES=30
CANDIDATE_QUOTE_MAX_AGE_SECONDS=30
CANDIDATE_ENTRY_TOLERANCE_PERCENT=0.25
CANDIDATE_XLSX_PATH=./data/suggested_trades.xlsx

# Durable audit ledger
AUDIT_DB_PATH=./data/audit.db
INTELLIGENCE_MAX_AGE_MINUTES=60
# Background global-intelligence worker starts with FastAPI and refreshes immediately, then on this interval.
INTELLIGENCE_AUTO_REFRESH=true
INTELLIGENCE_REFRESH_INTERVAL_MINUTES=30
