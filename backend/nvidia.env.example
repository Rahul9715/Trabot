# NVIDIA NIM profile. Copy these settings into backend/.env and fill the API key
# and model ID from your NVIDIA NIM account/catalog. Do not commit the filled .env.
AI_PROVIDER=nvidia
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TIMEOUT_SECONDS=60
AI_WEB_SEARCH_ENABLED=false

# Provider-specific aliases are also supported if you prefer these names.
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Keep real-money orders disabled. NVIDIA is used for research only.
LIVE_TRADING_ENABLED=false
